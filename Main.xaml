<Window x:Class="Store.Main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Store"
        mc:Ignorable="d"
        Title="Main" Height="1080" Width="1920">
    <Grid Background="#F5F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <UniformGrid Grid.Column="1" Rows="1" HorizontalAlignment="Left">
                    <Button x:Name="BtnContragents" Content="Contragents" Width="140" Height="40" Margin="5,0" FontSize="14" FontWeight="SemiBold" Click="BtnContragents_Click"/>
                    <Button x:Name="BtnTransactions" Content="Transactions" Width="140" Height="40" Margin="5,0" FontSize="14" FontWeight="SemiBold" Click="BtnTransactions_Click"/>
                </UniformGrid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <ComboBox x:Name="CbActiveIdentity" Width="220" Height="40" VerticalContentAlignment="Center" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,20,0" SelectionChanged="CbActiveIdentity_SelectionChanged"/>
                    <Button Grid.Column="2" x:Name="BtnFilters" Content="Filters" Width="120" Height="40" FontSize="14" FontWeight="SemiBold" Click="BtnFilters_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="#EAEDED" Padding="20,1" BorderBrush="#D5D8DC" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnAdd" Content="Add" Width="70" Height="30" Margin="0,0,10,0" Background="#2ECC71" Foreground="White" FontWeight="SemiBold" Click="BtnAdd_Click"/>
                <Button x:Name="BtnEdit" Content="Edit" Width="70" Height="30" Margin="0,0,10,0" Background="#3498DB" Foreground="White" FontWeight="SemiBold" Click="BtnEdit_Click"/>
                <Button x:Name="BtnDeleteMark" Content="Delete" Width="70" Height="30" Background="#E74C3C" Foreground="White" FontWeight="SemiBold" Click="BtnDeleteMark_Click"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="#FFFFFF" BorderThickness="1" BorderBrush="#E5E7EB">
            <ContentControl x:Name="MainContentArea" Margin="5"/>
        </Border>
    </Grid>
</Window>
